# ── Database ──────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/tam_copilot.db
DATA_DIR=./data
SECRET_KEY=generate-a-random-key-here
STATIC_DIR=./static

# ── Default LLM provider (seeded on first run, editable via UI) ──────
DEFAULT_PROVIDER_NAME=LiteMaaS
DEFAULT_PROVIDER_TYPE=openai_compatible
DEFAULT_PROVIDER_BASE_URL=https://litellm-prod.apps.maas.redhatworkshops.io
DEFAULT_PROVIDER_API_KEY=your-litemaas-api-key
DEFAULT_PROVIDER_MODEL=qwen3-14b

# ── Embeddings ───────────────────────────────────────────────────────
EMBEDDING_MODEL=nomic-embed-text-v1-5
SIMILARITY_THRESHOLD=0.82

# ── Red Hat APIs (Hydra + OCM) ───────────────────────────────────────
# Generate at: https://access.redhat.com/management/api
HYDRA_OFFLINE_TOKEN=
HYDRA_BASE_URL=https://api.access.redhat.com/support
OCM_BASE_URL=https://api.openshift.com
LIFECYCLE_BASE_URL=https://access.redhat.com/product-life-cycles/api/v1
API_TIMEOUT=30
